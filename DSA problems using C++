Perform binary search on roatated array

#include <iostream>
using namespace std;

int main() {
    int n, key;

    cout << "Enter number of elements: ";
    cin >> n;

    int arr[n];

    cout << "Enter elements (rotated sorted array): ";
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << "Enter element to search: ";
    cin >> key;

    int low = 0, high = n - 1;
    int found = -1;

    while(low <= high) {
        int mid = (low + high) / 2;

        if(arr[mid] == key) {
            found = mid+1;
            break;
        }

        // Check if left half is sorted
        if(arr[low] <= arr[mid]) {

            if(key >= arr[low] && key < arr[mid])
                high = mid - 1;
            else
                low = mid + 1;
        }
        // Otherwise right half is sorted
        else {

            if(key > arr[mid] && key <= arr[high])
                low = mid + 1;
            else
                high = mid - 1;
        }
    }

    if(found != -1)
        cout << "Element found at index: " << found;
    else
        cout << "Element not found";

    return 0;
}


