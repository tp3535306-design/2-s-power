Program to find minimum value from the stack

#include <iostream>
using namespace std;
int stack[15], mstack[10], top=-1,mtop=-1,n,val;
void push(int val)
{
    if(top>=n-1)
    cout<<"\nStack Overflow";
    else
    {
        top++;
        stack[top]=val;
        if(mtop<0|| mstack[mtop]>stack[top])
        {
            mtop++;
            mstack[mtop]=stack[top];
            cout<<"\nValue pushed into the stack";
        }
    }
}
void pop()
{
    if(top<0)
    cout<<"\nStack Underflow";
    else
    {
        if(mtop!=-1 && stack[top]==mstack[mtop])
        {
       
        top--;
        
        mtop--;
        cout<<"\nStack popped";
        }
        else
        {
           top--;
           cout<<"\nStack popped";
        }
    }
}
void display()
{
    if(top<0)
    cout<<"\nStack Underflow";
    else
    {
        cout<<"Stack: ";
        for(int i=top; i>=0; i--)
        cout<<endl<<stack[i];
    }
}
void min()
{
    if(mtop<0)
    cout<<"\nStack Underflow";
    else
    {
        cout<<"\nMinimum element from stack is: "<<mstack[mtop];
    }
}
int main() {
    cout<<"Enter size of stack: ";
    cin>>n;
   while(1)
   {
       int ch;
       cout<<"\n1->Push value\n2->Display stack\n3->Pop stack\n4->Minimum value\n5->Exit\nEnter Your Choice: ";
       cin>>ch;
       if(ch==1)
       {
           cout<<"Enter value to push in stack: ";
           cin>>val;
           push(val);
       }
       else if(ch==2)
       display();
       else if(ch==3)
       pop();
       else if(ch==4)
       min();
       else if(ch==5)
       break;
       else
       cout<<"\nInvalid choice";
   }

    return 0;
}

Program to check largest consecutive sequence

#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int n, a[100], i;
    cout<<"Enter size of array(max 100): ";
    cin>>n;

    cout<<"Enter "<<n<<" elements: ";
    for(i=0; i<n; i++)
        cin>>a[i];

    sort(a, a+n);   // Correct sorting

    int maxcount = 1;
    int count = 1;

    for(i=1; i<n; i++)
    {
        if(a[i] == a[i-1])   // skip duplicates
            continue;

        if(a[i] == a[i-1] + 1)
        {
            count++;
        }
        else
        {
            maxcount = max(maxcount, count);
            count = 1;
        }
    }

    maxcount = max(maxcount, count);

    cout<<"\nMaximum consecutive sequence length is: "<<maxcount;

    return 0;
}

Program to check duplicate element which is greater than array size

#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    int n, nums[100], ans = 0;

    cout<<"Enter size of array: ";
    cin>>n;

    cout<<"Enter "<<n<<" elements: ";
    for(int i=0;i<n;i++)
        cin>>nums[i];

    // Finding duplicate
    for(int i=0;i<n;i++)
    {
        int ele = abs(nums[i]);

        if(nums[ele] > 0)
            nums[ele] = -nums[ele];
        else
        {
            ans = ele;
            break;
        }
    }

    // Restoring original array
    for(int i=0;i<n;i++)
        nums[i] = abs(nums[i]);

    cout<<"Duplicate element is: "<<ans;

    return 0;
}
